#!/bin/sh
# The environment of every go this hook starts, built from nothing.
run() {
	env -i ${PATH:+PATH="$PATH"} ${HOME:+HOME="$HOME"} ${TMPDIR:+TMPDIR="$TMPDIR"} ${XDG_CACHE_HOME:+XDG_CACHE_HOME="$XDG_CACHE_HOME"} ${XDG_DATA_HOME:+XDG_DATA_HOME="$XDG_DATA_HOME"} ${XDG_STATE_HOME:+XDG_STATE_HOME="$XDG_STATE_HOME"} ${MISE_CACHE_DIR:+MISE_CACHE_DIR="$MISE_CACHE_DIR"} ${MISE_DATA_DIR:+MISE_DATA_DIR="$MISE_DATA_DIR"} ${MISE_STATE_DIR:+MISE_STATE_DIR="$MISE_STATE_DIR"} ${GOPATH:+GOPATH="$GOPATH"} ${GOCACHE:+GOCACHE="$GOCACHE"} ${GOMODCACHE:+GOMODCACHE="$GOMODCACHE"} ${HTTPS_PROXY:+HTTPS_PROXY="$HTTPS_PROXY"} ${HTTP_PROXY:+HTTP_PROXY="$HTTP_PROXY"} ${NO_PROXY:+NO_PROXY="$NO_PROXY"} ${https_proxy:+https_proxy="$https_proxy"} ${http_proxy:+http_proxy="$http_proxy"} ${no_proxy:+no_proxy="$no_proxy"} ${SSL_CERT_FILE:+SSL_CERT_FILE="$SSL_CERT_FILE"} ${GOPROXY:+GOPROXY="$GOPROXY"} ${GOPRIVATE:+GOPRIVATE="$GOPRIVATE"} ${GONOSUMDB:+GONOSUMDB="$GONOSUMDB"} ${GOSUMDB:+GOSUMDB="$GOSUMDB"} ${GOINSECURE:+GOINSECURE="$GOINSECURE"} GOWORK=off GOFLAGS=-mod=readonly MISE_OVERRIDE_CONFIG_FILENAMES=mise.toml MISE_OVERRIDE_TOOL_VERSIONS_FILENAMES=none MISE_ENV= MISE_AUTO_ENV=false MISE_GLOBAL_CONFIG_FILE=/dev/null/mise-global.toml MISE_SYSTEM_CONFIG_FILE=/dev/null/mise-system.toml GOENV=off GOTOOLCHAIN=local MISE_CEILING_PATHS="$(dirname -- "$(pwd -P)")" "$@"
}
# A go that is older than go.mod refuses with a bare "go: go.mod requires
# go >= ..." before tools/ci can say more, so this probe, which reads
# go.mod and builds nothing, lets go's own line through and says what to do.
# sh because no Go runs yet.
run go list -m >/dev/null </dev/null || {
	printf '%s\n' \
		"pre-push: the go on PATH ($(command -v go || echo none)) cannot run this module." \
		"pre-push: put the mise shims first on PATH, so that go is the pinned toolchain:" \
		"pre-push:   mise install, then mise activate in your shell profile (or mise activate --shims)." >&2
	exit 1
}
run go run ./tools/ci fast "$@"
