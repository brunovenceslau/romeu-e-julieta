#!/bin/sh
# The environment of every go this hook starts, built from nothing. It
# execs, so that a signal sent to the hook reaches go.
run() {
	exec env -i ${PATH:+PATH="$PATH"} ${HOME:+HOME="$HOME"} ${TMPDIR:+TMPDIR="$TMPDIR"} ${XDG_CACHE_HOME:+XDG_CACHE_HOME="$XDG_CACHE_HOME"} ${XDG_DATA_HOME:+XDG_DATA_HOME="$XDG_DATA_HOME"} ${XDG_STATE_HOME:+XDG_STATE_HOME="$XDG_STATE_HOME"} ${MISE_CACHE_DIR:+MISE_CACHE_DIR="$MISE_CACHE_DIR"} ${MISE_DATA_DIR:+MISE_DATA_DIR="$MISE_DATA_DIR"} ${MISE_STATE_DIR:+MISE_STATE_DIR="$MISE_STATE_DIR"} ${GOPATH:+GOPATH="$GOPATH"} ${GOCACHE:+GOCACHE="$GOCACHE"} ${GOMODCACHE:+GOMODCACHE="$GOMODCACHE"} ${HTTPS_PROXY:+HTTPS_PROXY="$HTTPS_PROXY"} ${HTTP_PROXY:+HTTP_PROXY="$HTTP_PROXY"} ${NO_PROXY:+NO_PROXY="$NO_PROXY"} ${https_proxy:+https_proxy="$https_proxy"} ${http_proxy:+http_proxy="$http_proxy"} ${no_proxy:+no_proxy="$no_proxy"} ${SSL_CERT_FILE:+SSL_CERT_FILE="$SSL_CERT_FILE"} ${GOPROXY:+GOPROXY="$GOPROXY"} ${GOPRIVATE:+GOPRIVATE="$GOPRIVATE"} ${GONOSUMDB:+GONOSUMDB="$GONOSUMDB"} ${GOSUMDB:+GOSUMDB="$GOSUMDB"} ${GOINSECURE:+GOINSECURE="$GOINSECURE"} GOWORK=off GOFLAGS=-mod=readonly MISE_OVERRIDE_CONFIG_FILENAMES=mise.toml MISE_OVERRIDE_TOOL_VERSIONS_FILENAMES=none MISE_ENV= MISE_AUTO_ENV=false MISE_GLOBAL_CONFIG_FILE=/dev/null/mise-global.toml MISE_SYSTEM_CONFIG_FILE=/dev/null/mise-system.toml MISE_AUTO_INSTALL=false MISE_NOT_FOUND_AUTO_INSTALL=false GOENV=off GOTOOLCHAIN=local MISE_CEILING_PATHS="$(dirname -- "$(pwd -P)")" "$@"
}
# A go older than go.mod refuses with a bare "go: go.mod requires go >=
# ..." before tools/ci can run, so this probe, which reads go.mod and
# builds nothing, lets go's own line through and then says what to do.
# It runs in a subshell, which a signal sent to the hook ends first. It
# is shell because it runs before any Go code can.
gopath=$(command -v go) || gopath=
if [ -z "$gopath" ] || ! (run go list -m) >/dev/null </dev/null; then
	{
		case $gopath in
		'')
			printf '%s\n' \
				"pre-push: no go is on PATH." \
				"pre-push: install mise, then put its shims on PATH, in your shell profile (bash and zsh):" \
				'pre-push:   eval "$(mise activate <shell> --shims)"' \
				"pre-push: for another shell, see mise activate --help."
			;;
		*/mise/shims/*)
			printf '%s\n' \
				"pre-push: the go on PATH ($gopath) is a mise shim that cannot run this module." \
				"pre-push: run \"mise trust\" and \"mise install\" in $(pwd -P), then push again."
			;;
		*)
			printf '%s\n' \
				"pre-push: the go on PATH ($gopath) cannot run this module." \
				"pre-push: put the mise shims first on PATH, so that go is the pinned toolchain, in your shell profile (bash and zsh):" \
				'pre-push:   eval "$(mise activate <shell> --shims)"' \
				"pre-push: for another shell, see mise activate --help."
			;;
		esac
	} >&2
	exit 1
fi
run go run ./tools/ci fast "$@"
